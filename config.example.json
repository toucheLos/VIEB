{
  "_comment": "Copy this file to config.json and edit for your machine. All paths must be absolute.",

  "dlc_project_path": "/absolute/path/to/VIEB-YourName-YYYY-MM-DD",
  "raw_videos_dir":   "/absolute/path/to/raw_videos",
  "results_dir":      "/absolute/path/to/results",

  "fps": 30,

  "arena_bounds": {
    "_comment": "Pixel coordinates of the arena boundary in the raw video frame (x = horizontal, y = vertical).",
    "x_min": 0,
    "y_min": 0,
    "x_max": 1280,
    "y_max": 960
  },

  "min_cluster_size": 2000,
  "collapse_threshold": 0.5,

  "use_wavelets": true,
  "enable_state_collapse": false,
  "export_clips": false,

  "context_groups": "A,B,C",
  "optional_report_columns": ["fear"],

  "onboarding_complete": false
}
