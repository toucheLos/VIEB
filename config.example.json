{
  "_comment": "Copy this file to config.json and edit for your machine. All paths must be absolute.",

  "dlc_project_path": "/absolute/path/to/VIEB-YourName-YYYY-MM-DD",
  "raw_videos_dir":   "/absolute/path/to/raw_videos",
  "results_dir":      "/absolute/path/to/results",

  "fps": 30,

  "arena_bounds": {
    "_comment": "Pixel coordinates of the arena boundary in the raw video frame (x = horizontal, y = vertical).",
    "x_min": 0,
    "y_min": 0,
    "x_max": 1280,
    "y_max": 960
  },

  "min_cluster_size": 2000,
  "collapse_threshold": 0.5,

  "use_wavelets": true,
  "enable_state_collapse": false,
  "export_clips": false,

  "context_groups": "A,B,C",
  "optional_report_columns": ["fear"],
  "metadata_schema": {
    "id_column": "filename",
    "column_map": {
      "session_id": "filename",
      "animal_id": "animal_id",
      "context": "context",
      "day": "day",
      "experiment": "experiment"
    },
    "optional_columns": {
      "fear": "fear"
    },
    "analysis_groups": [
      {
        "name": "Context",
        "column": "context",
        "enabled": true,
        "plots": ["state_fraction", "transition_matrix", "motif_enrichment"]
      },
      {
        "name": "Animal",
        "column": "animal_id",
        "enabled": true,
        "plots": ["state_fraction", "trajectory"]
      },
      {
        "name": "Fear",
        "column": "fear",
        "enabled": true,
        "plots": ["state_fraction"],
        "optional": true
      }
    ],
    "correlations": []
  },
  "ui_panels": {
    "learning_curves": {
      "enabled": false,
      "group_column": "context",
      "baseline_group": null,
      "comparison_group": null,
      "order_column": "day",
      "subject_column": "animal_id",
      "target_state": "auto"
    }
  },

  "onboarding_complete": false
}
